APP_NAME=极客优选智能客服
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 本地默认使用 backend/data/app.db；部署时可以改为 PostgreSQL 连接地址。
DATABASE_URL=sqlite:///./data/app.db

# 本地演示认证。部署时必须更换 AUTH_SECRET，并改用真实账号系统和安全密码哈希。
AUTH_SECRET=local-demo-secret-change-before-deploy
AUTH_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
DEMO_BUYER_A_PASSWORD=buyer-a-demo
DEMO_BUYER_B_PASSWORD=buyer-b-demo
DEMO_STAFF_PASSWORD=staff-demo

# 模型密钥只保存在后端的 .env 中，不要提交到 Git，也不要传给前端。
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_API_KEY=

# 使用 OpenAI 官方接口时留空；使用 OpenAI 兼容服务时填写其 API 根地址。
MODEL_BASE_URL=
MODEL_TEMPERATURE=0.1
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# 默认使用本地 BGE 中文语义向量；首次运行会下载模型，之后复用本地缓存。
# 改为 openai 后使用 MODEL_API_KEY 和兼容接口地址；local 仅用于测试和降级。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_CACHE_DIR=../.local/fastembed

# RAG 向量由 Milvus 保存和检索。Windows 本地开发请先用 Docker Desktop 启动 Milvus Standalone。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=knowledge_chunks
MILVUS_TIMEOUT_SECONDS=10

# Query 意图识别默认使用本地中文 ONNX Embedding，不调用聊天模型。
# 首次使用会下载模型到项目的 .local/fastembed，之后直接复用本地缓存。
INTENT_EMBEDDING_PROVIDER=fastembed
INTENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
INTENT_EMBEDDING_CACHE_DIR=../.local/fastembed
INTENT_ROUTE_MIN_SCORE=0.55
INTENT_ROUTE_MIN_MARGIN=0.0

KNOWLEDGE_VECTOR_WEIGHT=0.7
# BGE 混合检索最低分。低于该分数时不向模型提供无关知识片段。
KNOWLEDGE_MIN_SCORE=0.32
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=60
KNOWLEDGE_VECTOR_CANDIDATES=20
